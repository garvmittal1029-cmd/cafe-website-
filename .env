# ═══════════════════════════════════════════════════════════════
# Brew & Bloom — Environment Variables
# ═══════════════════════════════════════════════════════════════

# ─── MongoDB ─────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/brew_and_bloom?retryWrites=true&w=majority

# ─── Backend Server ──────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── CORS ────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Frontend (Vite) ────────────────────────────────────────
VITE_API_URL=http://localhost:5000/api
